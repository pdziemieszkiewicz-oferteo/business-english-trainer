{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "business-english",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "business-english",
      "database_id": "026e6ee9-23e4-448c-9904-033bc8b818ea"
    }
  ]
}
